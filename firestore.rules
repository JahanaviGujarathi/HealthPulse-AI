rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profile Documents
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Disease & Symptom Reports Collection
    match /reports/{reportId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['patient', 'village', 'disease', 'symptoms', 'status', 'severity']);
      allow update: if request.auth != null;
      allow delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['dho', 'state-admin'];
    }
    
    // Drinking Water Quality Telemetry Collection
    match /water_tests/{testId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['name', 'village', 'ph', 'turbidity', 'chlorine', 'bacteria', 'risk']);
      allow update, delete: if request.auth != null;
    }
    
    // Emergency Helplines Call Log Collection
    match /emergency_logs/{logId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['helpline', 'callerName', 'location']);
      allow update, delete: if request.auth != null;
    }
    
    // Security & Audit Events Ledger
    match /audit_logs/{auditId} {
      allow read: if request.auth != null;
      allow create: if request.resource.data.keys().hasAll(['actor', 'role', 'action', 'status', 'severity']);
      allow update, delete: if false; // Audit ledger is immutable once created
    }
  }
}
